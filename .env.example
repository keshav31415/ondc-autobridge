# Copy to .env. Local mode works without external credentials.
NODE_ENV=development
PORT=4100
WEB_ORIGIN=http://127.0.0.1:3100
API_ORIGIN=http://127.0.0.1:4100
# Empty = embedded PostgreSQL for local development. Required in production.
DATABASE_URL=
DATABASE_SSL=false
DATA_DIR=.data
INLINE_WORKER=true
ARTIFACT_DIR=.data/artifacts
# Set to 1 only when the API is reachable solely through your trusted load balancer.
TRUST_PROXY_HOPS=0
# Genuine Cline SDK runs are opt-in and require your model provider key.
CLINE_ENABLED=false
CLINE_PROVIDER=anthropic
CLINE_MODEL=claude-sonnet-4-6
CLINE_API_KEY=
CLINE_TIMEOUT_MS=180000
# This implementation exposes a local protocol profile, not a certified network node.
# Portal simulation works with disabled. sandbox enables authenticated lab endpoints.
PROTOCOL_MODE=disabled
ONDC_MERCHANT_ID=
ONDC_SUBSCRIBER_ID=
ONDC_SUBSCRIBER_URL=
ONDC_KEY_ID=
ONDC_SIGNING_PRIVATE_KEY=
ONDC_SIGNING_PUBLIC_KEY=
ONDC_REGISTRY_URL=
# JSON array of {subscriber,keyId,publicKey,uri}; lab peers only, outside Git.
ONDC_TRUSTED_KEYS_FILE=
# Comma-separated, verified HTTPS callback origins (never arbitrary buyer URLs).
ONDC_ALLOWED_CALLBACK_ORIGINS=
# Third-party access must be verified before enabling real logistics.
LOGISTICS_MODE=simulator
LOGISTICS_SUBSCRIBER_ID=
LOGISTICS_ENDPOINT=
LOGISTICS_ALLOWED_ORIGINS=
