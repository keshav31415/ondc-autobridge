{
  "name": "ondc-autobridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:web": "next dev apps/web --hostname 127.0.0.1 --port 3100",
    "build": "next build apps/web",
    "start:api": "tsx apps/api/src/index.ts",
    "start:web": "next start apps/web --hostname 0.0.0.0 --port 3100",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "worker": "tsx apps/api/src/worker-entry.ts"
  },
  "dependencies": {
    "@cline/sdk": "0.0.91",
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "lucide-react": "1.52.0",
    "multer": "^2.0.2",
    "next": "16.4.0",
    "pg": "^8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "26.6.4",
    "@types/pg": "^8.15.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "tsx": "^4.20.6",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
